ANTHROPIC_API_KEY=your_api_key_here
PORT=3000

# Unsplash — for real clothing photos on text searches
# Get a free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# remove.bg — background removal for Dress Me character overlay
# Get a free key (50 calls/month) at https://www.remove.bg/api
# Without this key, Dress Me uses mix-blend-mode to reduce background visibility
REMOVE_BG_API_KEY=your_remove_bg_api_key_here
